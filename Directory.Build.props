<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1848/CA1873: LoggerMessage delegates everywhere would add noise for cold paths; hot paths use them explicitly. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1716;CA1711;CA1031;CA2007;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1819;CA1002;CA1056;CA1054;CA1055;CA2227;CA1515;CA1812;CA1852;CA5394;CA1024;CA1508</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <Version>0.1.0</Version>
    <Authors>Exile Lens contributors</Authors>
    <Product>Exile Lens</Product>
    <Copyright>Exile Lens contributors. Not affiliated with or endorsed by Grinding Gear Games.</Copyright>
  </PropertyGroup>
</Project>
