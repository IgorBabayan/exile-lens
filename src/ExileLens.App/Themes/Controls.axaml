<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography (Inter is the default family via WithInterFont) -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>

  <!-- Cards & dividers -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <!-- Icons drawn with strokes -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource DurationFast}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource DurationFast}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Margin" Value="4,1" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Tooltips, context menus -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <!-- Thin, unobtrusive scrollbars -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource DurationFast}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Skeleton loading placeholders pulse gently (disabled when the window has the "no-anim" class) -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Window:not(.no-anim) Border.skeleton">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.45" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
