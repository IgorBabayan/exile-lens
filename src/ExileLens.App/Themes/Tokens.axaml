<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!--
    Design tokens. Warm neutrals with a terracotta accent, in the spirit of modern desktop productivity apps.
    Every color, radius, spacing step and duration used by views comes from here.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AppBackgroundColor">#F5F4EE</Color>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F4EE" />
      <Color x:Key="SidebarColor">#EEECE3</Color>
      <SolidColorBrush x:Key="SidebarBrush" Color="#EEECE3" />
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <Color x:Key="SurfaceAltColor">#F1EFE7</Color>
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1EFE7" />
      <Color x:Key="SurfaceHoverColor">#E9E6DC</Color>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E9E6DC" />
      <Color x:Key="BorderColor">#E2DED2</Color>
      <SolidColorBrush x:Key="BorderBrush" Color="#E2DED2" />
      <Color x:Key="BorderStrongColor">#CFCABC</Color>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFCABC" />
      <Color x:Key="TextPrimaryColor">#2A2925</Color>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2925" />
      <Color x:Key="TextSecondaryColor">#6B6860</Color>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6860" />
      <Color x:Key="TextTertiaryColor">#98958B</Color>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#98958B" />
      <Color x:Key="AccentColor">#C96442</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#C96442" />
      <Color x:Key="AccentHoverColor">#B5573A</Color>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#B5573A" />
      <Color x:Key="AccentSoftColor">#F3E2D9</Color>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#F3E2D9" />
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <Color x:Key="OverlayBackgroundColor">#FBFAF6</Color>
      <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#FBFAF6" />
      <Color x:Key="ScrollThumbColor">#33000000</Color>
      <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />
      <Color x:Key="SafeColor">#2F8F5B</Color>
      <SolidColorBrush x:Key="SafeBrush" Color="#2F8F5B" />
      <Color x:Key="WarningColor">#A87E1B</Color>
      <SolidColorBrush x:Key="WarningBrush" Color="#A87E1B" />
      <Color x:Key="DangerColor">#C24444</Color>
      <SolidColorBrush x:Key="DangerBrush" Color="#C24444" />
      <Color x:Key="NeutralColor">#7A7A7A</Color>
      <SolidColorBrush x:Key="NeutralBrush" Color="#7A7A7A" />
      <Color x:Key="RarityNormalColor">#5E5E5E</Color>
      <SolidColorBrush x:Key="RarityNormalBrush" Color="#5E5E5E" />
      <Color x:Key="RarityMagicColor">#4D5BD6</Color>
      <SolidColorBrush x:Key="RarityMagicBrush" Color="#4D5BD6" />
      <Color x:Key="RarityRareColor">#A57A10</Color>
      <SolidColorBrush x:Key="RarityRareBrush" Color="#A57A10" />
      <Color x:Key="RarityUniqueColor">#B4581F</Color>
      <SolidColorBrush x:Key="RarityUniqueBrush" Color="#B4581F" />
      <Color x:Key="RarityGemColor">#1A8C86</Color>
      <SolidColorBrush x:Key="RarityGemBrush" Color="#1A8C86" />
      <Color x:Key="RarityCurrencyColor">#8A7A55</Color>
      <SolidColorBrush x:Key="RarityCurrencyBrush" Color="#8A7A55" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AppBackgroundColor">#262624</Color>
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#262624" />
      <Color x:Key="SidebarColor">#1F1E1C</Color>
      <SolidColorBrush x:Key="SidebarBrush" Color="#1F1E1C" />
      <Color x:Key="SurfaceColor">#2F2E2B</Color>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2F2E2B" />
      <Color x:Key="SurfaceAltColor">#353431</Color>
      <SolidColorBrush x:Key="SurfaceAltBrush" Color="#353431" />
      <Color x:Key="SurfaceHoverColor">#3C3B37</Color>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3C3B37" />
      <Color x:Key="BorderColor">#3A3935</Color>
      <SolidColorBrush x:Key="BorderBrush" Color="#3A3935" />
      <Color x:Key="BorderStrongColor">#4A4843</Color>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4843" />
      <Color x:Key="TextPrimaryColor">#ECEAE3</Color>
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEAE3" />
      <Color x:Key="TextSecondaryColor">#AAA79D</Color>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAA79D" />
      <Color x:Key="TextTertiaryColor">#7F7C73</Color>
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7F7C73" />
      <Color x:Key="AccentColor">#C67A60</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#C67A60" />
      <Color x:Key="AccentHoverColor">#D48A70</Color>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#D48A70" />
      <Color x:Key="AccentSoftColor">#41302A</Color>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#41302A" />
      <Color x:Key="OnAccentColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <Color x:Key="OverlayBackgroundColor">#262624</Color>
      <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#262624" />
      <Color x:Key="ScrollThumbColor">#40FFFFFF</Color>
      <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF" />
      <Color x:Key="SafeColor">#4CAF76</Color>
      <SolidColorBrush x:Key="SafeBrush" Color="#4CAF76" />
      <Color x:Key="WarningColor">#D8AE46</Color>
      <SolidColorBrush x:Key="WarningBrush" Color="#D8AE46" />
      <Color x:Key="DangerColor">#E05A5A</Color>
      <SolidColorBrush x:Key="DangerBrush" Color="#E05A5A" />
      <Color x:Key="NeutralColor">#8B8B8B</Color>
      <SolidColorBrush x:Key="NeutralBrush" Color="#8B8B8B" />
      <Color x:Key="RarityNormalColor">#C8C8C8</Color>
      <SolidColorBrush x:Key="RarityNormalBrush" Color="#C8C8C8" />
      <Color x:Key="RarityMagicColor">#8E96FF</Color>
      <SolidColorBrush x:Key="RarityMagicBrush" Color="#8E96FF" />
      <Color x:Key="RarityRareColor">#E2C46B</Color>
      <SolidColorBrush x:Key="RarityRareBrush" Color="#E2C46B" />
      <Color x:Key="RarityUniqueColor">#D9894A</Color>
      <SolidColorBrush x:Key="RarityUniqueBrush" Color="#D9894A" />
      <Color x:Key="RarityGemColor">#37BDB5</Color>
      <SolidColorBrush x:Key="RarityGemBrush" Color="#37BDB5" />
      <Color x:Key="RarityCurrencyColor">#C4B48C</Color>
      <SolidColorBrush x:Key="RarityCurrencyBrush" Color="#C4B48C" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>


  <!-- Radii -->
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- Spacing (4-pt scale) -->
  <Thickness x:Key="SpaceXs">4</Thickness>
  <Thickness x:Key="SpaceSm">8</Thickness>
  <Thickness x:Key="SpaceMd">12</Thickness>
  <Thickness x:Key="SpaceLg">16</Thickness>
  <Thickness x:Key="SpaceXl">24</Thickness>
  <Thickness x:Key="PagePadding">32,28,32,28</Thickness>
  <Thickness x:Key="CardPadding">14,12</Thickness>

  <!-- Typography -->
  <x:Double x:Key="FontSizeCaption">11.5</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubtitle">15</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeDisplay">26</x:Double>

  <!-- Motion -->
  <sys:TimeSpan x:Key="DurationFast">0:0:0.12</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurationNormal">0:0:0.16</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurationSlow">0:0:0.2</sys:TimeSpan>

  <!-- Original line icons (24x24 grid) -->
  <StreamGeometry x:Key="IconOverview">M4,5 h7 v6 h-7 z M13,5 h7 v4 h-7 z M13,11 h7 v8 h-7 z M4,13 h7 v6 h-7 z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M10.5,4 a6.5,6.5 0 1 1 0,13 a6.5,6.5 0 1 1 0,-13 z M15.3,15.3 L20,20</StreamGeometry>
  <StreamGeometry x:Key="IconMap">M4,6 L9,4 L15,6 L20,4 V18 L15,20 L9,18 L4,20 z M9,4 V18 M15,6 V20</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 z</StreamGeometry>
  <StreamGeometry x:Key="IconHistory">M12,5 a7,7 0 1 1 -7,7 M5,6 V10 H9 M12,8.5 V12 L14.5,13.5</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M12,9 a3,3 0 1 1 0,6 a3,3 0 1 1 0,-6 z M12,3 V5.5 M12,18.5 V21 M3,12 H5.5 M18.5,12 H21 M5.6,5.6 L7.4,7.4 M16.6,16.6 L18.4,18.4 M5.6,18.4 L7.4,16.6 M16.6,7.4 L18.4,5.6</StreamGeometry>
  <StreamGeometry x:Key="IconPin">M9,4 H15 L14,9 L17,12 H7 L10,9 z M12,12 V20</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M19,8 A7.5,7.5 0 1 0 19.5,14 M19,4 V8 H15</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8,8 H18 V19 H8 z M5,16 V5 H15</StreamGeometry>
  <StreamGeometry x:Key="IconShield">M12,3 L19,6 V11.5 C19,15.8 16,19 12,21 C8,19 5,15.8 5,11.5 V6 z M12,8 V13 M12,16 V16.2</StreamGeometry>
  <StreamGeometry x:Key="IconWarning">M12,4 L21,19.5 H3 z M12,10 V14 M12,16.8 V17</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M12,3 a9,9 0 1 1 0,18 a9,9 0 1 1 0,-18 z M8,12.5 L11,15 L16,9.5</StreamGeometry>
  <StreamGeometry x:Key="IconQuestion">M12,3 a9,9 0 1 1 0,18 a9,9 0 1 1 0,-18 z M9.5,9.5 C9.5,6.5 14.5,6.5 14.5,9.5 C14.5,11.5 12,11.5 12,14 M12,16.8 V17</StreamGeometry>
  <StreamGeometry x:Key="IconInfo">M12,3 a9,9 0 1 1 0,18 a9,9 0 1 1 0,-18 z M12,11 V16.5 M12,7.8 V8</StreamGeometry>
  <StreamGeometry x:Key="IconChevron">M9,6 L15,12 L9,18</StreamGeometry>
  <StreamGeometry x:Key="IconExternal">M14,4 H20 V10 M20,4 L11,13 M18,14 V19 H5 V6 H10</StreamGeometry>
</ResourceDictionary>
