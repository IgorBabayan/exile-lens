<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ExileLens.App</RootNamespace>
    <AssemblyName>ExileLens</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Startup: ReadyToRun precompiles the app so cold start avoids most JIT work. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Keep the idle working set small: a tray utility does not need large gen0 budgets. -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CS0618: Avalonia marks some clipboard/storage members obsolete across 11.x minors; behaviour is unchanged. -->
    <NoWarn>$(NoWarn);CA1001;CA2000;CS0618;MVVMTK0034;MVVMTK0045</NoWarn>
    <!-- UI code follows Avalonia/MVVM Toolkit conventions that some analyzers flag; keep warnings visible but non-fatal here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- FluentTheme / ColorPaletteResources live in their own package. -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExileLens.Application\ExileLens.Application.csproj" />
    <ProjectReference Include="..\ExileLens.Infrastructure\ExileLens.Infrastructure.csproj" />
    <ProjectReference Include="..\ExileLens.Game.Poe1\ExileLens.Game.Poe1.csproj" />
    <ProjectReference Include="..\ExileLens.Game.Poe2\ExileLens.Game.Poe2.csproj" />
    <ProjectReference Include="..\ExileLens.Platform.Windows\ExileLens.Platform.Windows.csproj" />
    <ProjectReference Include="..\ExileLens.Platform.Linux\ExileLens.Platform.Linux.csproj" />
    <ProjectReference Include="..\ExileLens.Platform.MacOS\ExileLens.Platform.MacOS.csproj" />
  </ItemGroup>
</Project>
