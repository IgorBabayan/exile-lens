<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExileLens.App.ViewModels"
             x:Class="ExileLens.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource PagePadding}" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Overview" Classes="display" />
        <TextBlock Text="Hover an item in game and press your shortcut — results appear right next to it." Classes="secondary" />
      </StackPanel>

      <UniformGrid Columns="3">
        <Border Classes="panel" Margin="0,0,10,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Game" Classes="caption" />
            <TextBlock Text="{Binding GameName}" Classes="subtitle" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource SafeBrush}" IsVisible="{Binding IsConnected}" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource NeutralBrush}" IsVisible="{Binding !IsConnected}" />
              <TextBlock Text="{Binding ConnectionText}" Classes="secondary" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="panel" Margin="5,0">
          <StackPanel Spacing="6">
            <TextBlock Text="League" Classes="caption" />
            <TextBlock Text="{Binding League}" Classes="subtitle" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MarketStatus}" Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="panel" Margin="10,0,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Application" Classes="caption" />
            <TextBlock Text="Exile Lens" Classes="subtitle" />
            <TextBlock Text="{Binding Version}" Classes="secondary" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <TextBlock Text="Keyboard shortcuts" Classes="subtitle" />
          <ItemsControl ItemsSource="{Binding Shortcuts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutRow">
                <Grid ColumnDefinitions="200,Auto,*" Margin="0,4">
                  <TextBlock Text="{Binding Action}" Classes="secondary" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="8,3">
                    <TextBlock Text="{Binding Chord}" FontWeight="Medium" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" Margin="12,0,0,0"
                             TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding PlatformNote}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding PlatformNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*">
        <Border Classes="panel" Margin="0,0,8,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Recent price checks" Classes="subtitle" />
            <TextBlock Text="Nothing yet." Classes="secondary" IsVisible="{Binding !HasRecentPriceChecks}" />
            <ItemsControl ItemsSource="{Binding RecentPriceChecks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="secondary" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding When}" Classes="caption" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="panel" Margin="8,0,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Recent map checks" Classes="subtitle" />
            <TextBlock Text="Nothing yet." Classes="secondary" IsVisible="{Binding !HasRecentMapChecks}" />
            <ItemsControl ItemsSource="{Binding RecentMapChecks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="secondary" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding When}" Classes="caption" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="Exile Lens isn't affiliated with or endorsed by Grinding Gear Games. It only reads the item text the game copies to the clipboard after your key press." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
