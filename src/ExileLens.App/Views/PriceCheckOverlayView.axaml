<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExileLens.App.ViewModels"
             x:Class="ExileLens.App.Views.PriceCheckOverlayView"
             x:DataType="vm:PriceCheckOverlayViewModel">
  <!--
    Three rows: everything above the listings keeps its natural height, the listings take whatever height is left
    (and scroll on their own), the rewards/trade button stay pinned below. In the overlay the window caps the height,
    so only the listings scroll; embedded in a page the star row simply sizes to content.
  -->
  <UserControl.Styles>
    <!-- Modifier origin tag and in-game origin colors (order matters: the origin styles override the tag style;
         TextBlock and Run selectors stay separate so each setter resolves Foreground on its own type). -->
    <Style Selector="TextBlock.mod Run.tag">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.mod.fractured">
      <Setter Property="Foreground" Value="{DynamicResource ModFracturedBrush}" />
    </Style>
    <Style Selector="TextBlock.mod.fractured Run.tag">
      <Setter Property="Foreground" Value="{DynamicResource ModFracturedBrush}" />
    </Style>
    <Style Selector="TextBlock.mod.crafted">
      <Setter Property="Foreground" Value="{DynamicResource ModCraftedBrush}" />
    </Style>
    <Style Selector="TextBlock.mod.crafted Run.tag">
      <Setter Property="Foreground" Value="{DynamicResource ModCraftedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
  <StackPanel Grid.Row="0" Spacing="0">
    <!-- Header (drag handle: pressing anywhere except the buttons moves the overlay) -->
    <Grid Classes="drag-handle" Background="Transparent" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
      <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconSearch}" Stroke="{DynamicResource AccentBrush}" />
      <TextBlock Grid.Column="1" Text="Price check" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding GameLabel}" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
      <Button Grid.Column="3" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh results">
        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconRefresh}" />
      </Button>
      <Button Grid.Column="4" Classes="icon" Command="{Binding CopyPriceCommand}" ToolTip.Tip="Copy estimated price">
        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconCopy}" />
      </Button>
      <ToggleButton Grid.Column="5" Classes="icon" IsChecked="{Binding IsPinned}" ToolTip.Tip="Pin overlay" IsVisible="{Binding ShowWindowControls}">
        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconPin}" />
      </ToggleButton>
      <Button Grid.Column="6" Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)" IsVisible="{Binding ShowWindowControls}">
        <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconClose}" />
      </Button>
    </Grid>
    <Border Classes="divider" Margin="0,0,0,14" />

    <!-- Item -->
    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Panel>
          <Image Source="{Binding Icon}" Margin="4" Stretch="Uniform"
                 IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Initial}" Foreground="{Binding NameBrush}" FontSize="22" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
        </Panel>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding ItemName}" Foreground="{Binding NameBrush}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding BaseLine}" Classes="secondary" IsVisible="{Binding BaseLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding MetaLine}" Classes="secondary" />
      </StackPanel>
    </Grid>

    <!-- Unidentified unique: ask which unique it is; the search starts after the pick. -->
    <StackPanel IsVisible="{Binding IsChoosingUnique}" Spacing="6">
      <TextBlock Text="Which unique is this?" Classes="section" />
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="The item is unidentified, so its name is unknown. Pick the unique to price it." />
      <StackPanel IsVisible="{Binding IsLoadingUniques}" Spacing="6" Margin="0,4,0,2">
        <Border Classes="skeleton" Height="42" />
        <Border Classes="skeleton" Height="42" />
        <Border Classes="skeleton" Height="42" />
      </StackPanel>
      <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding !IsLoadingUniques}">
        <ItemsControl ItemsSource="{Binding UniqueChoices}" Margin="0,0,4,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UniqueChoiceViewModel">
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2" Padding="8,4,12,4"
                      Command="{Binding $parent[UserControl].((vm:PriceCheckOverlayViewModel)DataContext).ChooseUniqueCommand}"
                      CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- Fixed slot: rows keep their layout while the art streams in. -->
                  <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                    <Image Source="{Binding Icon}" Margin="2" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"
                             FontWeight="Medium" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding $parent[UserControl].((vm:PriceCheckOverlayViewModel)DataContext).UniqueBrush}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,6,0,0"
              Command="{Binding SkipUniqueChoiceCommand}" ToolTip.Tip="Search every unique on this base">
        <TextBlock Text="Any unique on this base" Classes="secondary" />
      </Button>
    </StackPanel>

    <StackPanel IsVisible="{Binding !IsChoosingUnique}" Spacing="0">
    <!-- Estimated market value -->
    <Border Classes="card" Padding="14,12">
      <StackPanel Spacing="4">
        <TextBlock Text="Estimated market value" Classes="secondary" />
        <StackPanel IsVisible="{Binding IsLoading}" Spacing="6" Margin="0,4,0,2">
          <Border Classes="skeleton" Width="160" Height="22" HorizontalAlignment="Left" />
          <Border Classes="skeleton" Width="230" Height="12" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPrice}">
            <TextBlock Text="{Binding PriceMain}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PriceCurrency}" FontSize="15" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,3"
                       IsVisible="{Binding PriceCurrencyIcon, Converter={x:Static ObjectConverters.IsNull}}" />
            <Image Source="{Binding PriceCurrencyIcon}" Width="26" Height="26" VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" ToolTip.Tip="{Binding PriceCurrency}"
                   IsVisible="{Binding PriceCurrencyIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <TextBlock Text="Unavailable" FontSize="18" FontWeight="Medium" Classes="secondary" IsVisible="{Binding !HasPrice}" />
          <TextBlock Text="{Binding PriceDetail}" Classes="secondary" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding PriceNote}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding PriceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="Filters changed — searching when you stop editing…" Classes="caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsSearchPending}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Modifier filters -->
    <TextBlock Text="Item modifiers" Classes="section" IsVisible="{Binding HasStatFilters}" />
    <ItemsControl ItemsSource="{Binding StatFilters}" IsVisible="{Binding HasStatFilters}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FilterItemViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
            <CheckBox IsChecked="{Binding Enabled}" MinHeight="28">
              <!-- One wrapping line: origin tag first, then the modifier, tinted like the game tooltip. -->
              <TextBlock Classes="mod" TextWrapping="Wrap" MaxWidth="290"
                         Classes.fractured="{Binding IsFractured}" Classes.crafted="{Binding IsCrafted}">
                <Run Classes="tag" Text="{Binding KindTag}" /><Run Text="{Binding Label}" />
              </TextBlock>
            </CheckBox>
            <TextBox Grid.Column="1" Text="{Binding MinText}" Width="58" MinHeight="26" Padding="6,3" FontSize="12"
                     PlaceholderText="min" IsEnabled="{Binding Enabled}" ToolTip.Tip="Minimum value" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Expander Header="Search filters" Margin="0,4,0,0" IsVisible="{Binding HasPropertyFilters}" Padding="0,2,0,0">
      <ItemsControl ItemsSource="{Binding PropertyFilters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterItemViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
              <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Label}" />
              <TextBox Grid.Column="1" Text="{Binding MinText}" Width="58" Padding="6,3" FontSize="12" PlaceholderText="min"
                       IsVisible="{Binding HasRange}" IsEnabled="{Binding Enabled}" />
              <TextBox Grid.Column="2" Text="{Binding MaxText}" Width="58" Padding="6,3" FontSize="12" PlaceholderText="max" Margin="6,0,0,0"
                       IsVisible="{Binding HasMax}" IsEnabled="{Binding Enabled}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <!-- Seller filter of this check (starts on "All"). Visible for every item search, even when it returned nothing. -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding CanOpenTrade}">
      <TextBlock Text="Sellers" Classes="secondary" VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="segmented">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Classes="segment" Content="All" IsChecked="{Binding AllSellers}"
                        ToolTip.Tip="All sellers matching the listing type in Settings" />
          <ToggleButton Classes="segment" IsChecked="{Binding OnlineSellersOnly}" ToolTip.Tip="Only sellers that are online right now">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource SafeBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Online" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Border>
    </Grid>
    </StackPanel>
  </StackPanel>

    <Expander Grid.Row="1" Header="Market listings" Margin="0,4,0,0" IsExpanded="{Binding ShowListings, Mode=TwoWay}" IsVisible="{Binding HasListings}" Padding="0,2,0,0">
      <!-- Only the listings scroll. Right margin keeps the auto-hide scrollbar off the age column. -->
      <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Listings}" Margin="0,0,14,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ListingItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
              <Panel>
                <TextBlock Text="{Binding Price}" FontWeight="Medium" MinWidth="120"
                           IsVisible="{Binding CurrencyIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="5" MinWidth="64" VerticalAlignment="Top" ToolTip.Tip="{Binding CurrencyName}"
                            IsVisible="{Binding CurrencyIcon, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Amount}" FontWeight="Medium" VerticalAlignment="Center" />
                  <Image Source="{Binding CurrencyIcon}" Width="18" Height="18" VerticalAlignment="Center"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                </StackPanel>
              </Panel>
              <StackPanel Grid.Column="1" Margin="8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource SafeBrush}" IsVisible="{Binding Online}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Seller}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Classes="caption" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Age}" Classes="caption" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Expander>

  <StackPanel Grid.Row="2" Spacing="0" IsVisible="{Binding !IsChoosingUnique}">
    <!-- Disenchantment / vendor / salvage -->
    <StackPanel IsVisible="{Binding HasRewards}">
      <Border Classes="divider" Margin="0,14,0,4" />
      <TextBlock Text="{Binding RewardTitle}" Classes="section" Margin="0,6,0,8" />
      <ItemsControl ItemsSource="{Binding RewardRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyValueRow">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBlock Text="{Binding Label}" Classes="secondary" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="260" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding RewardNote}" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding RewardNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                  IsVisible="{Binding Recommendation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconInfo}" Stroke="{Binding RecommendationBrush}" />
        <TextBlock Text="{Binding Recommendation}" Foreground="{Binding RecommendationBrush}" TextWrapping="Wrap" MaxWidth="360" />
      </StackPanel>
    </StackPanel>

    <Button Classes="accent" HorizontalAlignment="Stretch" Margin="0,16,0,0" Command="{Binding OpenTradeCommand}"
            IsVisible="{Binding CanOpenTrade}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Open in trade website" Foreground="{DynamicResource OnAccentBrush}" />
        <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconExternal}" Stroke="{DynamicResource OnAccentBrush}" />
      </StackPanel>
    </Button>
  </StackPanel>
  </Grid>
</UserControl>
